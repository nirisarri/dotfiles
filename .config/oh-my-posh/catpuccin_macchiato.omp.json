{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
        "os": "#E7AC95",
        "closer": "p:os",
        "pink": "#F5BDE6",
        "lavender": "#B7BDF8",
        "blue":  "#8AADF4"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:os",
    "template": "❯❯ "  
},
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:os",
          "style": "plain",
          "template": "{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "p:blue",
          "style": "plain",
          "template": "{{if .Root}}  {{end}} {{.UserName }}|",
          "type": "session"
        },
        {
          "foreground": "p:pink",
          "options": {
            "folder_separator_icon": "",
            "folder_icon": "....",
            "home_icon": " ",
            "style": "full",
            "right_format": "%s|",
            "mapped_locations": {
              "~/code":" "
            }
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "type": "git",
          "style":"plain",
          "foreground": "p:lavender",
          // "background_templates": [
          //   "{{ if or (.Working.Changed) (.Staging.Changed) }}#400000{{ end }}",
          //   "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#004000{{ end }}",
          //   "{{ if gt .Ahead 0 }}#000040{{ end }}",
          //   "{{ if gt .Behind 0 }}#600000{{ end }}"
          // ],
          "template": "{{ .UpstreamIcon }}  {{ .HEAD }}{{if .BranchStatus }}{{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "options": {
            "branch_icon": "",
            "branch_identical_icon": " ≡",
            "branch_behind_icon":" ↓",
            "branch_ahead_icon":" ↑",
            "branch_gone_icon": "",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          }
        }
        
      ],
      "type": "prompt"
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "template": "  {{ .FormattedMs }} ",
          "foreground": "p:pink",
          "options": {
            "threshold": 0,
            "style": "austin",
            "always_enabled": true
          }
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "foreground": "p:closer",
          "template": "❯",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],


  "final_space": true,
  "version": 4
}