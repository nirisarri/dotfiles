{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "📂",
            "home_icon": "🏡",
            "mapped_locations": [
              [
                "/home/nic/code/",
                "💻"
              ]
            ],
            "style": "agnoster"
          },
          "template": " {{ .Path }} ",
          "foreground": "#100e23",
          "powerline_symbol": "\ue0b0",
          "background": "#1E91EA",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue70c {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#F08864",
          "type": "dotnet",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_ahead_icon": "\uf55d",
            "branch_behind_icon": "\uf545",
            "branch_gone_icon": "\uf9e7",
            "branch_icon": "\uf418 ",
            "branch_identical_icon": "\uf9e5",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf448<#E84855>{{ .Working.String }}</>{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} \uf6d8{{ end }}{{ if .Staging.Changed }} \uf046 <#2FDA4E>{{ .Staging.String }}</>{{ end }} ",
          "foreground": "#f0f0f0",
          "powerline_symbol": "\ue0b0",
          "background": "#2E465D",
          "type": "git",
          "style": "powerline",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffeb3b{{ end }}",
            "{{ if gt .Ahead 0 }}#8A4FFF{{ end }}",
            "{{ if gt .Behind 0 }}#2EC4B6{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "node"
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "3:04:05"
          },
          "template": " \u231a{{ .CurrentDate | date .Format }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "newline"
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\uf438",
          "template": " \uf0e7 ",
          "foreground": "#FFEE58",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue7ad AWS{{.Profile}}{{if .Region}}@{{.Region}}{{end}} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#FFA400",
          "type": "aws",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "wsl": "",
            "wsl_separator": ""
          },
          "template": " {{ if .WSL }}WSL @ {{ end }}{{.Icon}} ",
          "foreground": "#26C6DA",
          "type": "os",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ if gt .Code 0 }} ❌{{ else }} \uf42e{{ end }} ",
          "foreground": "#66D372",
          "type": "exit",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#e91e63{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\ue0b1 ",
          "foreground": "#E06C75",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
