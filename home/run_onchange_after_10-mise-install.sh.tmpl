#!/bin/sh
# Installs the personal tools from ~/.config/mise/config.toml.
# Re-runs whenever that file changes: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -eu

export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  # Plain https://mise.run installs the binary only; the /zsh flavour appends
  # `mise activate` to ~/.zshrc, which chezmoi owns and already activates mise.
  curl -fsSL https://mise.run | sh
fi

cd "$HOME"
mise install --yes
