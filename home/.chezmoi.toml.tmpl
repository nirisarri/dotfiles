{{- /* Git identity. Placeholders below are only used where there's no TTY to
       prompt (DevPod also copies your host identity into the container's
       ~/.gitconfig, which wins). On interactive machines you're asked once and
       the answer is stored in the generated ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name := get . "name" | default (env "GIT_AUTHOR_NAME") | default "Nicolas De Irisarri" -}}
{{- $email := get . "email" | default (env "GIT_AUTHOR_EMAIL") | default "nirisarri@users.noreply.github.com" -}}
{{- if stdinIsATTY -}}
{{-   $name = promptStringOnce . "name" "Git user.name" $name -}}
{{-   $email = promptStringOnce . "email" "Git user.email" $email -}}
{{- end -}}

# Lets `chezmoi apply/edit/update` find this repo wherever it was cloned
# (DevPod clones it outside ~/.local/share/chezmoi).
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
