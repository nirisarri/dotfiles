" --- GENERAL SETTINGS ---
set clipboard+=unnamedplus   " Share clipboard with system
set hlsearch                 " Highlight search results
set ignorecase               " Ignore case in search
set smartcase                " Overrides ignorecase if search has capital letters
set number                   " Show line numbers
set relativenumber           " Show relative line numbers (great for motions)
set incsearch                " Show search matches as you type

" --- IDEAVIM PLUGINS ---
" These emulate popular Neovim/Vim plugins natively inside JetBrains
set surround                 " Emulates vim-surround (cs, ds, ysiw)
set commentary               " Emulates vim-commentary (gcc to comment line)
" set easymotion               " Emulates vim-easymotion
set sneak                    " Emulates vim-sneak (2-character search motion)
set which-key                 " Emulates which-key (shows popup for leader maps)
set notimeout

" increase the timeoutlen (default: 1000), don't add space around the equal sign
set timeoutlen=5000

" --- KEY MAPPINGS ---
" Set leader key to spacebar, just like many modern Neovim setups
let mapleader = " "
imap jj <Esc>
imap jk <Esc>

nmap s <Action>(flash.search)
xmap s <Action>(flash.search)


" Move selected block up and down in Visual mode
vmap K :m '<-2<CR>gv=gv
vmap J :m '>+1<CR>gv=gv

" Center the search result in the screen as we move through the results
nmap N Nzz
nmap n nzz

" Map <leader>fb to 'Recent Files' (Buffer Search)
nmap <leader>fb :action RecentFiles<CR>

" Map <leader>fs to 'Structure' (Document Symbols / Outline)
nmap <leader>fs :action FileStructurePopup<CR>

" Clear search highlights quickly
nmap <leader>h :nohlsearch<CR>

" Toggle the Project/Solution Tree sidebar
nmap <leader>e :action ActivateProjectToolWindow<CR>


" --- INTEGRATION WITH JETBRAINS IDE FEATURES ---
" Map your Neovim habits to trigger powerful JetBrains actions
nmap <leader>ff :action GotoFile<CR>         " Find file (like Telescope/FZF)
nmap <leader>fg :action FindInPath<CR>       " Live grep / Find in files
" nmap <leader>ee :action ActivateProjectToolWindow<CR> " Toggle file tree sidebar
nmap <leader>ca :action ShowIntentionActions<CR>     " Code actions / Quick fix

" Go to definition (like Neovim LSP)
nmap gd :action GotoDeclaration<CR>
" Find usages / references
nmap gr :action FindUsages<CR>
" Rename variable/method safely across the project
nmap <leader>rn :action RenameElement<CR>

map Q gq

" Plugins"
Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'

" Jetbrains IDE Integrations
map \r <Action>(ReformatCode)
map <leader>d <Action>(Debug)
map <leader>r <Action>(Refactorings.QuickListPopupAction)
map <leader><space> <Action>(ShowIntentionActions)
map <leader>w <Action>(EditorSelectWord)

map <C-S-[> :action EditorSelectWord<CR>
map <C-S-]> :action EditorUnselectWord<CR>
