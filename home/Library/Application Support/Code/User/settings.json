{
    "editor.fontSize": 16,
    // "editor.fontFamily": "'JetBrains Mono Thin'",
    // "editor.fontFamily": "'JetBrains Mono ExtraLight'",
    "editor.fontFamily": "'MesloLGLDZ Nerd Font Mono Ligaturized'",
    "editor.mouseWheelZoom": true,
    "terminal.integrated.fontLigatures.enabled": true,
    "workbench.iconTheme": "catppuccin-macchiato",
    "workbench.colorTheme": "Tokyo Night Gogh",
    "explorer.confirmDragAndDrop": false,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'MesloLGMDZ Nerd Font Ligaturized'",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "underline",
    "terminal.integrated.enableVisualBell": true,
    "vim.easymotion": true,
    "vim.useSystemClipboard": true,
    "vim.showcmd": true,
    "vim.hlsearch": true ,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.leader": "<space>",
    "vim.normalModeKeyBindings": [
        {
        "before": ["g", "p", "d"],
        "commands": ["editor.action.peekDefinition"]
        },
        {
        "before": ["g", "h"],
        "commands": ["editor.action.showDefinitionPreviewHover"]
        },
        {
        "before": ["g", "i"],
        "commands": ["editor.action.goToImplementation"]
        },
        {
        "before": ["g", "p", "i"],
        "commands": ["editor.action.peekImplementation"]
        },
        {
        "before": ["g", "q"],
        "commands": ["editor.action.quickFix"]
        },
        {
        "before": ["g", "r"],
        "commands": ["editor.action.referenceSearch.trigger"]
        },
        {
        "before": ["g", "t"],
        "commands": ["editor.action.goToTypeDefinition"]
        },
        {
        "before": ["g", "p", "t"],
        "commands": ["editor.action.peekTypeDefinition"]
        },
        {
        "before": ["<leader>", "e"],
        "commands": ["workbench.view.explorer"]
        }
    ],
    "editor.cursorSurroundingLines": 8,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "redhat.telemetry.enabled": false,
    "terminal.integrated.mouseWheelZoom": false,
    "editor.allowVariableFonts": false,
    "workbench.fontAliasing": "auto",
    "terminal.integrated.fontWeight": "normal",
    "markdown.preview.fontFamily": "'Aptos',-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "markdown.styles": [
        "pre code {font-family: 'JetBrains Mono ExtraLight';}"
    ],
    "github.copilot.nextEditSuggestions.enabled": true,
    "explorer.confirmDelete": false,
    "python.analysis.typeCheckingMode": "strict",
    "coverage-gutters.coverageFileNames": [
        "lcov.info",
        "cov.xml",
        "coverage.xml",
        "cobertura.xml",
        "jacoco.xml",
        "coverage.cobertura.xml",
        "coverage.lcov"
    ],
    "playwright.reuseBrowser": false,
    "chat.fontSize": 16,
    "chat.mcp.autostart": "newAndOutdated",
    "claudeCode.preferredLocation": "sidebar",
    "aws.cloudformation.telemetry.enabled": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.accessibilitySupport": "off",
    "python.defaultInterpreterPath": "/Users/nic/.pyenv/shims/python3",
    "docker.extension.enableComposeLanguageServer": false,
    "terminal.integrated.initialHint": false,
    "git.openRepositoryInParentFolders": "never",
    "diffEditor.renderSideBySide": false,
    "terminal.external.osxExec": "wezterm.app",
    "terminal.external.linuxExec": "wezterm.app",
    "terminal.explorerKind": "external",
    "terminal.integrated.cursorWidth": 2,
    "markdown-preview-enhanced.previewTheme": "vscode.css",
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schema.management.azure.com": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "editor.renderWhitespace": "all",
    "azureFunctions.showProjectWarning": false,
    "dev.containers.forwardWSLServices": false,
    "chat.hookFilesLocations": {
        ".github/hooks": true,
        ".claude/settings.local.json": true,
        ".claude/settings.json": true,
        "~/.copilot/hooks": true,
        "~/.claude/settings.json": true,
        "~/.agents/hooks": true
    },
    "git.autofetch": true,
    "gitlens.launchpad.indicator.enabled": false,
    "chat.tools.terminal.autoApprove": {
        "pytest": true,
        "bun": true,
        "docker cp": true,
        "docker restart": true,
        "git fetch": true
    },
    "hediet.vscode-drawio.resizeImages": null,
    "chat.mcp.gallery.enabled": true,
    "chat.mcp.apps.enabled": true,
    "chat.mcp.access": "all",
    "chat.agent.maxRequests": 100,
    "git.confirmSync": false,
    "remote.autoForwardPortsSource": "hybrid",
    "diffEditor.ignoreTrimWhitespace": false,
    "claudeCode.useTerminal": true,
    "chat.viewSessions.orientation": "stacked",
    "terminal.integrated.fontSize": 15,
    "mssql.autoDisableNonTSqlLanguageService": true,
    "editor.lineNumbers": "relative",
    "editor.codeActionsOnSave": {

    },
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    }
}