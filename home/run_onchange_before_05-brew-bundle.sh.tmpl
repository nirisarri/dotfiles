#!/bin/sh
# Installs Homebrew (if missing) and runs `brew bundle` from the pared-down
# Brewfile — casks and formulae mise doesn't cover. macOS only; a no-op
# elsewhere. Re-runs whenever that file changes: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
{{- if eq .chezmoi.os "darwin" }}
set -eu

if ! command -v brew >/dev/null 2>&1; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle --file="$HOME/.config/homebrew/Brewfile"
{{- end }}
