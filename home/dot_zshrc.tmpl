{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $wsl = true -}}
{{-   end -}}
{{- end -}}
# ============================================================================
# ZSH Configuration File (.zshrc) — managed by chezmoi
# ============================================================================
# Edit the source with `chezmoi edit ~/.zshrc`, then `chezmoi apply`.
# Rendered per machine: macOS host, Linux devcontainers, WSL.
# Machine-specific tweaks that shouldn't be shared go in ~/.zshrc.local.
# ============================================================================

# ============================================================================
# HOMEBREW ENVIRONMENT
# ============================================================================
{{- if eq .chezmoi.os "darwin" }}
export homebrew="/opt/homebrew"
{{- else }}
export homebrew="/home/linuxbrew/.linuxbrew"
{{- end }}
if [[ -x $homebrew/bin/brew ]]; then
  path+=("$homebrew"/bin)
  eval "$($homebrew/bin/brew shellenv)"
fi

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
path+=("$HOME/.local/bin")

# path+=("/usr/local/go/bin")
# path+=("$HOME/go/bin")

# ============================================================================
# MISE
# ============================================================================
# Must run before the tool-detection blocks below: starship, zoxide, eza, bat
# and fzf all live in mise's PATH, so `(( $+commands[...] ))` fails without it.
if [[ -x $HOME/.local/bin/mise ]]; then
  eval "$($HOME/.local/bin/mise activate zsh)"
fi


# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# ============================================================================
# KEYBINDINGS
# ============================================================================
# Use emacs keybindings even if our EDITOR is set to vi
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
{{- if $wsl }}
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word
{{- else }}
# Option+Left/Right (macOS terminals, also when attached to a devcontainer)
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
{{- end }}

# ============================================================================
# COMPLETION SYSTEM
# ============================================================================
autoload -Uz compinit
compinit

zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu select=2
# eval "$(dircolors -b)"
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' menu select=long
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true

zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# ============================================================================
# FZF (FUZZY FINDER) + ZOXIDE
# ============================================================================
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
  # Use fd for faster file searching with fzf, excluding .git directories
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type d --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --number {}"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always --level=2 {}"
fi

# zoxide must be initialised after compinit for its completions to work.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
  alias "cd"="z"
fi

# alias to open fzf with a preview window for file contents or directory tree
fzp() {
  fzf --preview 'bat --color=always --style=numbers --line-range=:500 {} 2>/dev/null || eza --tree --color=always --level=2 {}' \
      --preview-window=right,60%,border-left \
      --bind 'ctrl-/:toggle-preview' "$@"
}

# alias to open a file selected via fzf in the default editor
vf() {
  local file
  file=$(fzp --query="$1") && ${EDITOR:-vim} "$file"
}

# ============================================================================
# COMMAND ALIASES
# ============================================================================
if (( $+commands[eza] )); then
  alias ll='eza --git --icons=always -l'
  alias la='eza --git --icons=always -la'
  alias ls='eza --icons=always'
  alias l='eza --git --icons=always -l'
  alias tree='eza --git --icons=always -T'
fi

if (( $+commands[chezmoi] )); then
  alias cm='chezmoi'
  alias cme='chezmoi edit'
  alias cma='chezmoi apply'
fi

# Docker aliases
alias d='docker'
alias dc='docker compose'
alias dcup='docker compose up -d'
alias dss='docker stack services'
alias ds='docker stack'

# Utility aliases
alias tf='terraform'

if (( $+commands[bat] )); then
  alias cat='bat'
  alias cat2='/bin/cat'          # Fallback to system cat
fi
alias thanos='rm -rf'          # Dangerous remove (use with caution!)
alias ".."="cd .."
alias "..."="cd ../.."
alias "...."="cd ../../.."
alias "~"="cd ~"

# Neovim as the default editor if available
if (( $+commands[nvim] )); then
  alias v='nvim'
  export EDITOR="nvim"
fi

# AWS PROFILE MANAGEMENT FUNCTION
if (( $+commands[aws] )); then
  awsp() {
    if [[ -z "$1" ]]; then
      grep '^\[profile ' ~/.aws/config 2>/dev/null | sed 's/\[profile \(.*\)\]/\1/' | sort
    else
      if [[ "$1" == "-" ]]; then
        unset AWS_PROFILE
        echo "AWS_PROFILE unset"
      else
        export AWS_PROFILE="$1"
        echo "AWS_PROFILE set to: $AWS_PROFILE"
      fi
    fi
  }
fi

{{- if $wsl }}
# wsl: use the windows ssh client/agent
alias ssh='ssh.exe'
alias ssh-add='ssh-add.exe'
{{- end }}

# ============================================================================
# PYENV
# ============================================================================
# export PYENV_ROOT="$HOME/.pyenv"
# [[ -d $PYENV_ROOT/bin ]] && path=("$PYENV_ROOT/bin" $path)
# (( $+commands[pyenv] )) && eval "$(pyenv init - zsh)"
# 
# ============================================================================
# UV TOOL SHELL COMPLETIONS
# ============================================================================
(( $+commands[uv] )) && eval "$(uv generate-shell-completion zsh)"

{{- if eq .chezmoi.os "darwin" }}
# ============================================================================
# SSH AGENT REDIRECT TO 1PASSWORD (macOS only — in devcontainers DevPod
# forwards the host agent and sets SSH_AUTH_SOCK itself)
# ============================================================================
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{- end }}



# ============================================================================
# PROMPT INITIALIZATION
# ============================================================================
if [[ "$TERM_PROGRAM" != "Apple_Terminal" ]] && (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ============================================================================
# ZSH PLUGIN SOURCING (fetched by chezmoi, see .chezmoiexternal.toml)
# ============================================================================
# zsh-syntax-highlighting must be sourced last.
zsh_plugins=~/.local/share/zsh/plugins
[[ -f $zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] \
  && source $zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f $zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
  && source $zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
unset zsh_plugins
