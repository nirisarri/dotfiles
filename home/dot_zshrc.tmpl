# ============================================================================
# PYENV
# ============================================================================
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && path=("$PYENV_ROOT/bin" $path)
(( $+commands[pyenv] )) && eval "$(pyenv init - zsh)"

# ============================================================================
# UV TOOL SHELL COMPLETIONS
# ============================================================================
(( $+commands[uv] )) && eval "$(uv generate-shell-completion zsh)"
{{- if eq .chezmoi.os "darwin" }}

# ============================================================================
# SSH AGENT REDIRECT TO 1PASSWORD (macOS only — in devcontainers DevPod
# forwards the host agent and sets SSH_AUTH_SOCK itself)
# ============================================================================
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{- end }}

# ============================================================================
# NVIM DOCKER WRAPPER FUNCTION
# ============================================================================
lvim () {
  if [ ! $# -eq 0 ]; then
    [[ -d "$1" ]] || [[ -f "$1" ]] || touch "$1"
    [[ -f "$1" ]] && NWD="$(dirname $1)" || NWD="$(realpath $1)"
    docker run -it --rm --name nvim-docker-cli-$(date +%s) \
    -e NVIM_DISTRO="lazyvim" \
    -w "/edit$NWD" \
    -v "$(realpath $1)":"/edit$(realpath $1)" \
    -v nvim-home:/root \
    ghcr.io/lanjelin/nvim-docker:slim \
    nvim "/edit$(realpath $1)"
  else
    docker run -it --rm --name nvim-docker-cli-$(date +%s) \
    -e NVIM_DISTRO="lazyvim" \
    -w "/root" \
    -v nvim-home:/root \
    ghcr.io/lanjelin/nvim-docker:slim \
    nvim
  fi
}

